#!/usr/bin/env bash
# Gate G1 before the commit, not after: raw.githubusercontent serves master to
# installed apps the moment it is pushed. Runs tools/verify_feeds.mjs on the
# staged feeds, only when a feed file is staged.
# Install once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git diff --cached --name-only -- latest.json latest.json.sig latest-dev.json latest-dev.json.sig)" ]; then
  node tools/verify_feeds.mjs --staged
fi
