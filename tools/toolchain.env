# The one place the build's toolchain pins live (as upstream awalol 994f310,
# 898c352). .github/workflows/build.yml and release.yml load it into $GITHUB_ENV;
# tools/dev_firmware.sh and tools/release.sh check a local setup against it
# (tools/toolchain.sh). Plain KEY=value lines, no quotes or shell syntax.
#
# TinyUSB is the commit upstream pins (hathach/tinyusb PR #3758, after 0.21.0).
# CMakeLists.txt's relocate_to_ram() section names follow TinyUSB 0.21, and the
# configure step refuses another TinyUSB minor version.
#
# Every download is checked, not only named: PICO_SDK_COMMIT is the commit the
# 2.3.0 tag points at (CI and tools/install_toolchain.sh fail if the tag
# moves), ARM_TOOLCHAIN_SHA256 the tarball's SHA-256 as ARM publishes it
# (ARM_TOOLCHAIN_URL + .sha256asc; checked against a download 2026-10-31).
# NODE_VERSION is the exact Node every workflow sets up (a release 14+ days
# old, as the app's dependencies); tools/check_ci_pins.py checks all four.
PICO_SDK_REF=2.3.0
PICO_SDK_COMMIT=98a542c1a62fb549ffb5d66a3e5892b06276b670
TINYUSB_REF=2d56dc533e45e4e91b15e93fdab5e22e964f328d
ARM_TOOLCHAIN_VERSION=15.2.rel1
ARM_TOOLCHAIN_URL=https://gitlab.arm.com/api/v4/projects/tooling%2Fgnu-toolchains-for-arm/packages/generic/gnu-toolchain/15.2.rel1/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi.tar.xz
ARM_TOOLCHAIN_SHA256=597893282ac8c6ab1a4073977f2362990184599643b4c5ee34870a8215783a16
NODE_VERSION=22.23.3
